{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node runs build.ts, dev.ts and test.ts directly, and esbuild bundles the
    // page, so tsc is only ever asked a question.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,

    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}
